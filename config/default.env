# ========================================================
# Environment Configurations
# ========================================================

# Ingestion / Kafka Broker
KAFKA_BROKER=localhost:9092
KAFKA_RAW_TOPIC=upi.transactions.raw
KAFKA_ALERTS_TOPIC=upi.fraud.alerts
KAFKA_CHAINS_TOPIC=upi.mule.chains

# Processing Engine (Flink)
FLINK_JOBMANAGER_HOST=localhost
FLINK_JOBMANAGER_PORT=8081
STATE_BACKEND=rocksdb
CHECKPOINT_INTERVAL_MS=5000

# Analytical Store (ClickHouse)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
CLICKHOUSE_DB=fraud_stream

# Web Dashboard & Alert Server
DASHBOARD_PORT=3000
STREAM_INTERVAL_MS=500
MULE_BURST_PROBABILITY=0.20

